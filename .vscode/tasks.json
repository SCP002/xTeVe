{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: format, sort imports, lint",
      "detail": "Runs goimports, golines at 120 columns, then golangci-lint --fix",
      "type": "shell",
      "command": "./format.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "golangci-lint",
        "severity": "warning",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "label": "xTeVe: run",
      "detail": "go run . at port 34400, config in /root/.xteve",
      "type": "shell",
      "command": "go run . -port 34400",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Web UI: dev server",
      "detail": "Vite at http://localhost:5173/web/, reloads on changes, forwards to xTeVe at port 34400",
      "type": "shell",
      "command": "npm ci --no-audit --no-fund && npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Web UI: build",
      "detail": "Builds web/dist/app, embedded by the next go build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    },
    {
      "label": "Web UI: check",
      "detail": "svelte-check and tsc",
      "type": "shell",
      "command": "npm run check",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "problemMatcher": []
    }
  ]
}
