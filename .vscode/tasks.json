{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: format, sort imports, lint",
      "detail": "Runs goimports, golines at 120 columns, then golangci-lint --fix",
      "type": "shell",
      "command": "./format.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "golangci-lint",
        "severity": "warning",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    },
    {
      "type": "typescript",
      "tsconfig": "ts/tsconfig.json",
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build",
      "label": "tsc build"
    },
    {
      "label": "Web UI: dev server",
      "detail": "Vite at port 5173, forwarding to xTeVe at port 34400 (XTEVE=... to change)",
      "type": "npm",
      "script": "dev",
      "path": "web",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web UI: check",
      "detail": "svelte-check and tsc",
      "type": "npm",
      "script": "check",
      "path": "web",
      "problemMatcher": []
    }
  ]
}
